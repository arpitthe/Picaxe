# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://picaxe:password@localhost:5432/picaxe?schema=public"

# JWT Authentication
JWT_SECRET="change-me-in-production-super-secret-key-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Storage (Cloudflare R2 or S3)
STORAGE_PROVIDER="r2"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_BUCKET="picaxe-media"
STORAGE_ACCESS_KEY_ID="your_storage_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_access_key"
STORAGE_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="face_embeddings"

# AI Microservices
AI_SERVICE_URL="http://localhost:8000"
NLP_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TIMEOUT=30000

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"
